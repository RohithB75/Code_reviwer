# AI Code Reviewer - environment example
# Copy to .env and edit values before running `docker compose up`

# --- Backend settings ---
APP_NAME=AI Code Reviewer API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Provide CORS origins as a JSON array so pydantic-settings can parse it
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# --- Local LLM (Ollama) settings ---
# If running the backend in Docker on Windows/Mac, use host.docker.internal
# instead of localhost so the container can reach Ollama on your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
MODEL_NAME=

# --- LLM provider selection ---
# Global default provider for lighter tasks (Review, Performance, Security,
# Refactoring, Unit Tests). "ollama" (local, free) or "groq" (cloud).
LLM_PROVIDER=ollama
# Optional: if the primary provider fails (timeout/connection error), retry
# automatically with this provider instead. Leave blank to disable.
LLM_FALLBACK_PROVIDER=groq

# --- Groq (cloud) settings ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# --- Per-task override: Documentation generation is the heaviest task
# (needs a bigger context window and stronger instruction-following than a
# small local model reliably gives), so it can be pinned to Groq
# independently of the global LLM_PROVIDER above. Leave both blank to just
# inherit LLM_PROVIDER / LLM_FALLBACK_PROVIDER instead.
DOCUMENTATION_LLM_PROVIDER=groq
DOCUMENTATION_LLM_FALLBACK_PROVIDER=ollama

# --- Frontend settings ---
BACKEND_BASE_URL=http://backend:8000
STREAMLIT_SERVER_PORT=8501

# --- Other ---
LOG_LEVEL=INFO